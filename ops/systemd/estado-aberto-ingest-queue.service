[Unit]
Description=Estado Aberto post-update ingest queue
After=estado-aberto.service

[Service]
Type=oneshot
User=estado-aberto
Group=estado-aberto
EnvironmentFile=-/etc/estado-aberto/ingest.env
ExecStart=/usr/local/sbin/estado-aberto-ingest-queue
TimeoutStartSec=14400
Nice=10
IOSchedulingClass=idle
CPUWeight=20
MemoryMax=400M
SyslogIdentifier=estado-aberto-ingest-queue
