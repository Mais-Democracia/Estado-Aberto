[Unit]
Description=Estado Aberto 6-hourly data refresh
After=network-online.target
Wants=network-online.target
OnFailure=estado-aberto-alert@%n.service

[Service]
Type=oneshot
User=estado-aberto
Group=estado-aberto
WorkingDirectory=/opt/estado-aberto/current
EnvironmentFile=-/etc/estado-aberto/ingest.env
Environment=ESTADO_ABERTO_DATA=/var/lib/estado-aberto/data
Environment=STATE_DIR=/var/lib/estado-aberto/state
ExecStart=/usr/local/bin/estado-aberto-python ingest/run_all.py --schedule 6h --profile server --lock-wait 1500
SuccessExitStatus=75
TimeoutStartSec=3600
Nice=10
IOSchedulingClass=idle
CPUWeight=20
MemoryHigh=350M
MemoryMax=450M
SyslogIdentifier=estado-aberto-refresh
