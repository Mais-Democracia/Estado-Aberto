    "ine.pt",
    "dados.gov.pt",
    "base.gov.pt",
    "entidadetransparencia.pt",
    "tribunalconstitucional.pt",
    "concorrencia.pt",
    "erc.pt",
    "cnpd.pt",
    "sns.gov.pt",
    "justica.gov.pt",
    "eleicoes.mai.gov.pt",
    "cresap.pt",
    "eo.gov.pt",
    "alra.pt",
    "alram.pt",
    "madeira.gov.pt",
    "azores.gov.pt"
  ],
  "nomes_comuns": [
    "Portugal",
    "Governo",
    "Estado",
    "Parlamento",
    "Assembleia",
    "República",
    "Plenário",
    "Presidente",
    "Ministério",
    "Ministro",
    "Ministra",
    "Comissão",
    "Lei",
