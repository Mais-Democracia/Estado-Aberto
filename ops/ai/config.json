  ],
  "exclusoes": {
    "tipos": [
      "nomeacao_gabinete",
      "exoneracao"
    ],
    "padroes": [
      "processo[s]?\\s+(crime|criminal|penal|disciplinar|contraordena)",
      "arguid",
      "acusa[cç][aã]o",
      "pron[uú]ncia",
      "condena",
      "inqu[eé]rito[- ]crime",
      "\\bdisciplinar",
      "\\bdespacho\\b.*\\b(sr\\.?|sra\\.?|senhor|senhora|cidad[aã]o)\\b",
      "empres[aá]rio em nome individual",
      "comerciante em nome individual",
      "sentenc",
      "tr[aá]fico",
      "burla",
      "corrup[cç][aã]o ativa"
    ]
  },
  "cargos_publicos": [
