{
  "provider": "cli",
  "claude_bin_default": "/opt/claude-cli/claude",
  "models": {
    "haiku": "haiku",
    "sonnet": "sonnet",
    "opus": "opus"
  },
  "prices_usd_per_million": {
    "haiku": [
      1,
      5
    ],
    "sonnet": [
      3,
      15
    ],
    "opus": [
      5,
      25
    ]
  },
  "eur_per_usd": 0.92,
  "budgets": {
    "max_usd_day": 2.5,
    "max_usd_month": 60,
    "max_articles": 5
  },
  "pipeline": {
    "shortlist_size": 25,
    "select_from": 12
  },
  "stages": {
    "triage": {
      "tier": "haiku",
      "prompt": "triage",
      "schema": "triage",
      "max_usd": 0.15
    },
    "selecao": {
      "tier": "opus",
      "prompt": "selecao",
      "schema": "selecao",
      "max_usd": 0.4
    },
    "redacao": {
      "tier": "sonnet",
      "prompt": "redacao",
      "schema": "artigo",
      "max_usd": 0.4
    },
    "revisao": {
      "tier": "opus",
      "prompt": "revisao",
      "schema": "revisao",
      "max_usd": 0.4
    }
  },
  "prompt_versions": {
    "triage": "1",
    "selecao": "1",
    "redacao": "1",
    "revisao": "1"
  },
  "estimates": {
    "triage": {
      "in_per_candidate": 320,
      "out": 1500
    },
    "selecao": {
      "in_per_candidate": 1000,
      "out": 1000
    },
    "redacao": {
      "in": 38000,
      "out": 1500
    },
    "revisao": {
      "in": 19500,
      "out": 600
    }
  },
  "cli": {
    "timeout_s": 420,
    "args": [
      "-p",
      "--model",
      "{model}",
      "--output-format",
      "json",
      "--json-schema",
      "{schema_json}",
      "--system-prompt-file",
      "{system_prompt_file}",
      "--tools",
      "Read,Grep,Glob",
      "--allowedTools",
      "{read_rules}",
      "--disallowedTools",
      "Bash,WebFetch,WebSearch,Write,Edit,Task",
      "--strict-mcp-config",
      "--bare",
      "--setting-sources",
      "user",
      "--permission-mode",
      "dontAsk",
      "--no-session-persistence",
      "--max-budget-usd",
      "{max_usd}"
    ],
    "provenance": {
      "-p": "verified in claude --help 2.1.314 (-p, --print)",
      "--model": "verified in claude --help 2.1.314",
      "--output-format": "verified in claude --help 2.1.314",
      "--json-schema": "verified in claude --help 2.1.314 (only with --print)",
      "--system-prompt-file": "referenced in 2.1.314 help only as --system-prompt[-file] (under --bare); not listed as a separate option; confirm with check_cli.py --live",
      "--tools": "verified in claude --help 2.1.314",
      "--allowedTools": "verified in claude --help 2.1.314",
      "--disallowedTools": "verified in claude --help 2.1.314",
      "--strict-mcp-config": "verified in claude --help 2.1.314",
      "--bare": "verified in claude --help 2.1.314 (skips hooks, CLAUDE.md discovery, keychain/OAuth; auth is ANTHROPIC_API_KEY only)",
      "--setting-sources": "verified in claude --help 2.1.314 (value user|project|local; an empty value is unverified and not used; 'user' is the dedicated empty HOME)",
      "--permission-mode": "verified in claude --help 2.1.314 (choices acceptEdits, auto, bypassPermissions, manual, dontAsk, plan)",
      "--no-session-persistence": "verified in claude --help 2.1.314",
      "--max-budget-usd": "verified in claude --help 2.1.314",
      "--max-turns": "not present in 2.1.314 help: removed; cost bounded by --max-budget-usd and timeout_s"
    },
    "version_verified": "2.1.314"
  },
  "confianca_min": 0.7,
  "max_words": 250,
  "pdf": {
    "max_bytes": 10485760,
    "timeout_s": 20,
    "max_pages": 8,
    "max_chars": 60000
  },
  "related_api": {
    "votacoes": "/api/votacoes/iniciativa?key={fonte_ref}",
    "leis": "/api/initiative?key={fonte_ref}",
    "agenda": "/api/initiative?key={fonte_ref}",
    "anuncios": "/api/contract?id={fonte_ref}",
    "entities": "/api/entity?id={fonte_ref}"
  },
  "site_routes": [
    "#/leis",
    "#/votacoes",
    "#/deputados",
    "#/anuncios",
    "#/orcamento",
    "#/edicao",
    "#/divida",
    "#/dre",
    "#/autarquias",
    "#/apoios",
    "#/fundos",
    "#/ministerios"
  ],
