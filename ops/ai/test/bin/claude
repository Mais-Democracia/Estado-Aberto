#!/usr/bin/env python3
import json
import os
import re
import sys
from pathlib import Path

argv = sys.argv[1:]
if "--help" in argv:
    omit = set(filter(None, os.environ.get("AI_STUB_HELP_OMIT", "").split(",")))
    flags = ["-p, --print", "--model <model>", "--output-format <format>", "--json-schema <schema>", "--system-prompt[-file]", "--tools <tools...>",
             "--allowedTools, --allowed-tools <tools...>", "--disallowedTools, --disallowed-tools <tools...>", "--strict-mcp-config", "--bare",
             "--setting-sources <sources>", "--permission-mode <mode>  (choices: acceptEdits, auto, bypassPermissions, manual, dontAsk, plan)",
             "--no-session-persistence", "--max-budget-usd <amount>"]
    print("Usage: claude [options]\n" + "\n".join("  " + f for f in flags if not any(o in f for o in omit)))
    sys.exit(0)
opt = {}
i = 0
while i < len(argv):
    if argv[i].startswith("--") and i + 1 < len(argv):
        opt[argv[i]] = argv[i + 1]
        i += 2
    else:
        i += 1
prompt = sys.stdin.read()
sp = Path(opt.get("--system-prompt-file", "")).read_text(encoding="utf-8") if opt.get("--system-prompt-file") else ""
m = re.match(r"# stage: (\w+)", sp)
stage = m.group(1) if m else "?"
cwd = Path.cwd()
log = os.environ.get("AI_STUB_LOG")
if log:
    ri = cwd / "rascunho_revisao.txt"
    with open(log, "a", encoding="utf-8") as f:
        f.write(json.dumps({"stage": stage, "cwd": str(cwd), "model": opt.get("--model"), "allowed": opt.get("--allowedTools"), "schema": bool(opt.get("--json-schema")),
                            "files": sorted(p.name for p in cwd.iterdir()), "review_input": ri.read_text(encoding="utf-8") if ri.exists() else None, "argv": argv}) + "\n")
beh = json.loads(os.environ.get("AI_STUB_BEHAVIOR") or "{}").get(stage)
stdir = os.environ.get("AI_STUB_STATE")
if beh == "fail_once" and stdir:
    mark = Path(stdir) / ("once_" + stage)
    if not mark.exists():
        mark.write_text("1")
        sys.exit(1)
    beh = None
if beh == "touch_stop":
    Path(os.environ["AI_STUB_STOPFILE"]).write_text("")
if beh == "fail_cost":
    print(json.dumps({"type": "result", "subtype": "error_max_budget_usd", "is_error": True, "total_cost_usd": 0.31, "usage": {"input_tokens": 100, "output_tokens": 10}}))
    sys.exit(1)
if beh == "fail_nocost":
    sys.exit(3)
if beh == "timeout":
    import time
    time.sleep(30)
if beh == "badjson":
    print("nao e json")
    sys.exit(0)


def rd(name):
    p = cwd / name
    return p.read_text(encoding="utf-8") if p.exists() else ""


def strip(s):
    return re.sub(r"</?fonte_nao_confiavel>\s*", "", s).strip()


usage = {"input_tokens": 1000, "output_tokens": 300}
if stage == "triage":
    c = json.loads(rd("candidates.json"))
    out = {"ranking": [{"id": x["id"], "motivo": "relevante"} for x in sorted(c, key=lambda x: -(x["score"] or 0))]}
    usage = {"input_tokens": 8000, "output_tokens": 1500}
elif stage == "selecao":
    c = json.loads(rd("candidates.json"))
    n = json.loads(rd("limite.json"))["max_historias"]
    out = {"historias": [{"evento_id": x["id"], "motivo": "importante"} for x in c[:n]]}
    usage = {"input_tokens": 12000, "output_tokens": 1000}
elif stage in ("redacao", "redacao_lei", "redacao_votacao", "redacao_agregado"):
    f = json.loads(rd("facts.json"))
    ev = f["eventos"][0]
    titulo, resumo = strip(ev["titulo"]), strip(ev["resumo_curto"])
    corpo = resumo + " O caso consta do registo oficial."
    if "INVENTADO" in titulo:
        corpo += " Foram gastos 7 777 777 euros."
    if "ignora" in rd("texto.txt").lower():
        corpo += " Segundo o texto, o valor foi de 999 999 euros."
    hrefs = json.loads(rd("fontes.json"))["hrefs_permitidos"]
    out = {"titulo": titulo, "lead": resumo, "corpo": corpo,
           "pontos_chave": ["Facto registado.", "Fonte oficial.", "Dados do dia."],
           "fontes": [{"label": "Fonte", "href": hrefs[0]}], "numeros_citados": [], "calculos": [], "entidades": [], "confianca": float(os.environ.get("AI_STUB_CONFIANCA", "0.9"))}
    if stage in ("redacao_lei", "redacao_votacao"):
        lei = f.get("lei") or {}
        lines = [x.strip() for x in strip(rd("texto.txt")).splitlines() if len(x.strip()) >= 15]
        if lei.get("texto_disponivel") and len(lines) >= 3:
            out["explicacao"] = {"do_que_trata": "A iniciativa trata do tema indicado no título.",
                                 "o_que_muda": [{"texto": "Segundo o texto da iniciativa, existe uma medida concreta prevista.", "evidencia": x} for x in lines[:3]]}
        else:
            out["explicacao"] = {"do_que_trata": "A iniciativa trata do tema do título; o texto da iniciativa não estava disponível.", "o_que_muda": []}
    ov = os.environ.get("AI_STUB_OVERRIDE")
    if ov:
        for rule in json.loads(Path(ov).read_text(encoding="utf-8")):
            if rule["match"] in titulo:
                out.update(rule["draft"])
                if "corpo_append" in rule:
                    out["corpo"] += rule["corpo_append"]
    usage = {"input_tokens": 38000, "output_tokens": 1500}
elif stage == "revisao":
    bad = "REJEITAR" in rd("facts.json")
    out = {"veredicto": "rejeitar" if bad else "ok", "alegacoes_sem_suporte": ["afirmacao sem suporte"] if bad else []}
    usage = {"input_tokens": 19500, "output_tokens": 600}
else:
    sys.exit(2)
print(json.dumps({"type": "result", "subtype": "success", "is_error": False, "result": "", "structured_output": out, "usage": usage}))
